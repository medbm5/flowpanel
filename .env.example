# Copy to .env (never commit .env). All values below are local-dev defaults.
DATABASE_URL=jdbc:postgresql://localhost:5433/flowpanel
DATABASE_USERNAME=flowpanel
DATABASE_PASSWORD=flowpanel
# mock (default, deterministic, no key needed) or live (OpenAI)
AI_PROFILE=mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_DAILY_BUDGET_USD=2
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
CORS_ORIGINS=http://localhost:3000
